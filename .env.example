# WorkBuddy 云应用配置
WB_ENDPOINT=https://daily-english-38358.app.workbuddy.host
WB_KEY=wbpk_REDACTED

# 用于自动写库的账号（GitHub Secrets 里配置，切勿提交真实密码）
WB_EMAIL=your@email.com
WB_PASSWORD=

# 可选：直接用已有 access_token，免登录
WB_TOKEN=

# LLM（消耗 WorkBuddy 积分）
LLM_MODEL=glm-5.3-flash

# TTS
TTS_VOICE=en-US-JennyNeural
TTS_RATE=+0%
TTS_CONCURRENCY=4

# 音频公开访问前缀（结尾带 /）
# jsDelivr: https://cdn.jsdelivr.net/gh/<owner>/<repo>@main/audio/
# R2:       https://audio.example.com/
AUDIO_BASE=

# 保持未来多少天的语料缓冲（每周补齐到这个窗口）
DAYS=30
